{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/messages.ts": {
      "maxDuration": 800
    },
    "api/requests.ts": {
      "maxDuration": 800
    },
    "api/slack.ts": {
      "maxDuration": 30
    },
    "api/slack-worker.ts": {
      "maxDuration": 800,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "openclaw-drives-slack"
        }
      ]
    },
    "api/slack-idle.ts": {
      "maxDuration": 800,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "openclaw-drives-idle"
        }
      ]
    }
  }
}
