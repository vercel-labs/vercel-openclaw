# Populate VERCEL_OIDC_TOKEN with vercel env pull; never commit it.
# Supply an AI Gateway key in your local shell or ignored environment file.
# AI_GATEWAY_API_KEY=
OPENCLAW_IMAGE=openclaw-foundation/openclaw/openclaw:2026.9.6
OPENCLAW_MODEL=openai/gpt-5.4
# HTTP controller only: use a write-capable Redis REST token.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# OPENCLAW_CONTROL_TOKEN=  # generate a random token of at least 32 characters
# OPENCLAW_CONTROLLER_NAMESPACE=  # defaults to project ID; keep stable
# OPENCLAW_CONTROLLER_PORT=8787
