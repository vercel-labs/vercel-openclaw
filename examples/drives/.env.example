# Populate VERCEL_OIDC_TOKEN with vercel env pull; never commit it.
# Supply an AI Gateway key in your local shell or ignored environment file.
# AI_GATEWAY_API_KEY=
OPENCLAW_IMAGE=openclaw-foundation/openclaw/openclaw:2026.9.6
OPENCLAW_MODEL=openai/gpt-5.4
# HTTP and Slack controllers: use a write-capable Redis REST token.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# OPENCLAW_CONTROL_TOKEN=  # HTTP API only; random token of at least 32 characters
# OPENCLAW_CONTROLLER_NAMESPACE=  # defaults to project ID; keep stable
# OPENCLAW_CONTROLLER_PORT=8787
# Optional isolated Slack test adapter (see README).
# SLACK_CONNECTOR=slack/your-test-connector
# OPENCLAW_SLACK_POLICY={"teamId":"T...","appId":"A...","channelId":"C...","userId":"U...","botUserId":"U..."}
# OPENCLAW_SLACK_QUEUE_SECRET=  # separate random secret, at least 32 characters
