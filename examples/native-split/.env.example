# Function settings. Keep this file local; add real values through Vercel environment variables.
SPLIT_AGENT_ID=review-proof
# Set this for the local smoke client. The deployed Function uses VERCEL_URL automatically.
# SPLIT_PUBLIC_URL=https://your-isolated-deployment.example
SPLIT_CONTROL_TOKEN=
SPLIT_WORKER_IMAGE=vcr.vercel.com/your-team/your-project/dockerfile@sha256:REPLACE_WITH_BUILT_DIGEST
SPLIT_STORAGE_MODE=ephemeral-proof
SPLIT_REDIS_URL=
SPLIT_REDIS_TOKEN=
AI_GATEWAY_API_KEY=
OPENCLAW_MODEL=openai/gpt-5.4
# In a Function, Sandbox uses project workload identity automatically.
# Local administration additionally needs VERCEL_TOKEN, VERCEL_TEAM_ID and VERCEL_PROJECT_ID.
