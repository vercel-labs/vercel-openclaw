+import { describe, expect, it } from "vitest";
+import { resolveModelRoutes } from "./provider-policy-api.js";
+
+const provider = "vercel-ai-gateway";
+const baseUrl = "https://ai-gateway.vercel.sh/codex/v1";
+
+describe("Vercel Codex route compatibility", () => {
+  it("keeps the existing embedded route as the default", () => {
+    expect(resolveModelRoutes({ provider })).toBeNull();
+  });
+
+  it("declares Codex only for the explicit Responses endpoint", () => {
+    expect(
+      resolveModelRoutes({
+        provider,
+        modelId: "vendor/test-model",
+        configuredProvider: { api: "openai-responses", baseUrl },
+      }),
+    ).toMatchObject({
+      kind: "routes",
+      routes: [
+        {
+          api: "openai-responses",
+          baseUrl,
+          authRequirement: "api-key",
+          requestTransportOverrides: "none",
+          runtimePolicy: { compatibleIds: ["openclaw", "codex"] },
+        },
+      ],
+      defaultRuntimeId: "openclaw",
+    });
+  });
+
+  it.each([
+    "http://ai-gateway.vercel.sh/codex/v1",
+    "https://ai-gateway.vercel.sh.evil.example/codex/v1",
+    "https://secret@ai-gateway.vercel.sh/codex/v1",
+    "https://ai-gateway.vercel.sh:8443/codex/v1",
+    `${baseUrl}?token=secret`,
+    `${baseUrl}#fragment`,
+    "https://ai-gateway.vercel.sh/v1",
+  ])("does not declare native compatibility for %s", (endpoint) => {
+    const result = resolveModelRoutes({
+      provider,
+      configuredProvider: { api: "openai-responses", baseUrl: endpoint },
+    });
+    expect(
+      result?.kind === "routes" ? result.routes[0].runtimePolicy?.compatibleIds : [],
+    ).not.toContain("codex");
+  });
+
+  it("does not erase a model-specific endpoint or transport override", () => {
+    for (const extra of [
+      { configuredModel: { baseUrl: "https://other.example/v1" } },
+      { configuredModel: { api: "anthropic-messages" as const } },
+      { requestTransportOverrides: "present" as const },
+    ]) {
+      const result = resolveModelRoutes({
+        provider,
+        configuredProvider: { api: "openai-responses", baseUrl },
+        ...extra,
+      });
+      expect(
+        result?.kind === "routes" ? result.routes[0].runtimePolicy?.compatibleIds : [],
+      ).not.toContain("codex");
+    }
+  });
+});
