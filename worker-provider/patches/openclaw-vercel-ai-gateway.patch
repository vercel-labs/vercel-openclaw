diff --git a/src/agents/runtime-plan/prepare-auth.vercel.test.ts b/src/agents/runtime-plan/prepare-auth.vercel.test.ts
new file mode 100644
index 00000000..72fe3a01
--- /dev/null
+++ b/src/agents/runtime-plan/prepare-auth.vercel.test.ts
@@ -0,0 +1,118 @@
+import { describe, expect, it } from "vitest";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import {
+  buildAgentHarnessSupportContext,
+  projectPreparedModelProvider,
+} from "../harness/support.js";
+import { prepareAgentRuntimeAuth } from "./prepare-auth.js";
+
+const provider = "vercel-ai-gateway";
+const baseUrl = "https://ai-gateway.vercel.sh/codex/v1";
+const config: OpenClawConfig = {
+  models: {
+    providers: {
+      [provider]: {
+        api: "openai-responses",
+        baseUrl,
+        apiKey: "fixture-vercel-key",
+        models: [],
+      },
+    },
+  },
+};
+const params = {
+  provider,
+  modelId: "vendor/test-model",
+  modelApi: "openai-responses",
+  modelBaseUrl: baseUrl,
+  config,
+  env: {},
+  authProfileStore: { version: 1, profiles: {} },
+  harnessId: "codex",
+  harnessRuntime: "codex",
+  harnessAuthBootstrap: "harness" as const,
+};
+
+describe("Vercel Codex route preparation", () => {
+  it("carries the declared route and credential mode from early to finalized selection", () => {
+    const selection = {
+      provider,
+      modelId: params.modelId,
+      config,
+      requestedRuntime: "codex" as const,
+    };
+    const early = buildAgentHarnessSupportContext(selection);
+    expect(early.modelProvider?.runtimePolicy?.compatibleIds).toContain("codex");
+    const prepared = prepareAgentRuntimeAuth(params);
+    expect(prepared.attempts).toHaveLength(1);
+    expect(prepared.plan).toMatchObject({
+      providerForAuth: provider,
+      harnessAuthProvider: provider,
+      selectedAuthMode: "api-key",
+      modelRoute: { provider, baseUrl, authRequirement: "api-key" },
+    });
+    const final = buildAgentHarnessSupportContext({
+      ...selection,
+      preparedModelProvider: true,
+      modelProvider: projectPreparedModelProvider({
+        plan: prepared.plan,
+        attemptKind: prepared.attempts[0]?.kind,
+      }),
+    });
+    expect(final.modelProvider?.runtimePolicy).toEqual(early.modelProvider?.runtimePolicy);
+    expect(final.modelProvider?.preparedAuth).toEqual({
+      source: "direct",
+      mode: "api-key",
+      requirement: "api-key",
+    });
+  });
+
+  it("does not discover an OpenAI account when the Vercel key is missing", () => {
+    const result = prepareAgentRuntimeAuth({
+      ...params,
+      config: {
+        models: { providers: { [provider]: { api: "openai-responses", baseUrl, models: [] } } },
+      },
+      env: { OPENAI_API_KEY: "unrelated-openai-key" },
+      authProfileStore: {
+        version: 1,
+        profiles: { "openai:work": { type: "api_key", provider: "openai", key: "wrong-key" } },
+      },
+    });
+    expect(result.plan.harnessAuthProvider).toBe(provider);
+    expect(result.plan.forwardedAuthProfileId).toBeUndefined();
+    expect(result.plan.credentialSource).toEqual({
+      kind: "direct",
+      evidence: "runtime",
+      authorization: "declared",
+    });
+    expect(result.attempts[0]).toMatchObject({ kind: "direct", allowAuthProfileFallback: false });
+  });
+
+  it.each(["vercel-ai-gateway", "openai"])(
+    "enforces credential ownership for a pinned %s profile",
+    (profileProvider) => {
+      const prepare = () =>
+        prepareAgentRuntimeAuth({
+          ...params,
+          sessionAuthProfileId: "fixture:work",
+          sessionAuthProfileSource: "user",
+          authProfileStore: {
+            version: 1,
+            profiles: {
+              "fixture:work": { type: "api_key", provider: profileProvider, key: "fixture-key" },
+            },
+          },
+        });
+      if (profileProvider === provider) {
+        expect(prepare().plan).toMatchObject({
+          forwardedAuthProfileId: "fixture:work",
+          selectedAuthMode: "api_key",
+          modelRoute: { provider, authRequirement: "api-key" },
+        });
+      } else {
+        expect(prepare).toThrow(/not configured for vercel-ai-gateway/u);
+      }
+    },
+  );
+});
