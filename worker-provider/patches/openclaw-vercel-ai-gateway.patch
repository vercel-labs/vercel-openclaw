+import fs from "node:fs/promises";
+import { withTempDir } from "openclaw/plugin-sdk/test-env";
+import { describe, expect, it } from "vitest";
+import {
+  applyCodexAppServerAuthProfile,
+  bridgeCodexAppServerStartOptions,
+  resolveCodexAppServerPreparedAuthHandoff,
+} from "./auth-bridge.js";
+import type { CodexAppServerStartOptions } from "./config.js";
+import { createClientHarness } from "./test-support.js";
+import { resolveCodexAppServerSpawnEnv } from "./transport-stdio.js";
+
+const preparedAuth = {
+  kind: "api-key",
+  apiKey: "fixture-vercel-key",
+  nativeProvider: "vercel",
+} as const;
+const startOptions: CodexAppServerStartOptions = {
+  transport: "stdio",
+  homeScope: "agent",
+  commandSource: "resolved-managed",
+  command: "codex",
+  args: ["app-server"],
+  headers: {},
+};
+const config = {
+  model_provider: "vercel",
+  model_providers: {
+    vercel: {
+      name: "Vercel AI Gateway",
+      base_url: "https://ai-gateway.vercel.sh/codex/v1",
+      env_key: "AI_GATEWAY_API_KEY",
+      wire_api: "responses",
+    },
+  },
+};
+
+describe("prepared Vercel Codex credentials", () => {
+  it("injects only the scoped key and verifies the provider without an OpenAI login", async () => {
+    await withTempDir("codex-vercel-auth-", async (tempDir) => {
+      const agentDir = await fs.realpath(tempDir);
+      const catalogPath = `${agentDir}/models.json`;
+      await fs.writeFile(catalogPath, JSON.stringify({ models: [{ slug: "vendor/test-model" }] }));
+      const nativeConfig = {
+        ...config,
+        chatgpt_base_url: "https://chatgpt.com/backend-api/",
+        model_catalog_json: catalogPath,
+      };
+      const bridged = await bridgeCodexAppServerStartOptions({
+        startOptions: {
+          ...startOptions,
+          env: {
+            AI_GATEWAY_API_KEY: "ambient-gateway",
+            OPENAI_API_KEY: "ambient-openai",
+            CODEX_API_KEY: "ambient-codex",
+            CODEX_ACCESS_TOKEN: "ambient-token",
+          },
+        },
+        agentDir,
+        preparedAuth,
+      });
+      const env = resolveCodexAppServerSpawnEnv(bridged, {});
+      expect(env.AI_GATEWAY_API_KEY).toBe(preparedAuth.apiKey);
+      for (const name of ["OPENAI_API_KEY", "CODEX_API_KEY", "CODEX_ACCESS_TOKEN"]) {
+        expect(env[name]).toBeUndefined();
+      }
+      expect(env.CODEX_HOME).toBe(`${agentDir}/codex-home`);
+      expect(bridged.args).toContain('cli_auth_credentials_store="ephemeral"');
+      const methods: string[] = [];
+      const harness = createClientHarness({
+        onWrite(line, send) {
+          const request = JSON.parse(line) as { id: number; method: string };
+          methods.push(request.method);
+          send({ id: request.id, result: { config: nativeConfig, origins: {} } });
+        },
+      });
+      try {
+        await applyCodexAppServerAuthProfile({
+          client: harness.client,
+          agentDir,
+          preparedAuth,
+          startOptions: bridged,
+        });
+        expect(methods).toEqual(["config/read"]);
+        await expect(fs.stat(`${agentDir}/codex-home/auth.json`)).rejects.toMatchObject({
+          code: "ENOENT",
+        });
+      } finally {
+        harness.client.close();
+      }
+    });
+  });
+
+  it.each([
+    {
+      label: "unprepared route",
+      homeScope: "agent" as const,
+      authRequirement: undefined,
+      resolvedApiKey: "fixture-key",
+    },
+    {
+      label: "native home",
+      homeScope: "user" as const,
+      authRequirement: "api-key" as const,
+      resolvedApiKey: "fixture-key",
+    },
+    {
+      label: "subscription",
+      homeScope: "agent" as const,
+      authRequirement: "subscription" as const,
+      resolvedApiKey: "fixture-key",
+    },
+    {
+      label: "missing key",
+      homeScope: "agent" as const,
+      authRequirement: "api-key" as const,
+      resolvedApiKey: " ",
+    },
+  ])(
+    "rejects $label without native auth fallback",
+    async ({ homeScope, authRequirement, resolvedApiKey }) => {
+      await expect(
+        resolveCodexAppServerPreparedAuthHandoff({
+          provider: "vercel-ai-gateway",
+          homeScope,
+          authRequirement,
+          resolvedApiKey,
+          authProfileStore: { version: 1, profiles: {} },
+          subscriptionProfileRequiredError: "unused",
+          subscriptionProfileUnusableError: "unused",
+        }),
+      ).rejects.toThrow();
+    },
+  );
+
+  it.each([
+    { label: "remote transport", patch: { transport: "websocket" as const } },
+    { label: "native home", patch: { homeScope: "user" as const } },
+    { label: "custom command", patch: { commandSource: "config" as const } },
+    { label: "HTTP proxy", patch: { env: { HTTPS_PROXY: "https://proxy.example.invalid" } } },
+  ])("rejects $label before handing off the key", async ({ patch }) => {
+    await expect(
+      bridgeCodexAppServerStartOptions({
+        startOptions: { ...startOptions, ...patch },
+        agentDir: "/unused",
+        preparedAuth,
+      }),
+    ).rejects.toThrow("direct managed stdio");
+  });
+
+  it.each([
+    { model_provider: "openai" },
+    { ...config, chatgpt_base_url: "https://relay.example.invalid/" },
+    { ...config, openai_base_url: "https://api.openai.com/v1" },
+  ])(
+    "rejects effective provider or endpoint overrides without logging in: %j",
+    async (effective) => {
+      const methods: string[] = [];
+      const harness = createClientHarness({
+        onWrite(line, send) {
+          const request = JSON.parse(line) as { id: number; method: string };
+          methods.push(request.method);
+          send({ id: request.id, result: { config: effective, origins: {} } });
+        },
+      });
+      try {
+        await expect(
+          applyCodexAppServerAuthProfile({
+            client: harness.client,
+            agentDir: "/workspace",
+            preparedAuth,
+            startOptions: { ...startOptions, env: { AI_GATEWAY_API_KEY: preparedAuth.apiKey } },
+          }),
+        ).rejects.toThrow("trusted Vercel provider");
+        expect(methods).toEqual(["config/read"]);
+      } finally {
+        harness.client.close();
+      }
+    },
+  );
+});
