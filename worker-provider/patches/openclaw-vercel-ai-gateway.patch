index 00000000..be1b9465
--- /dev/null
+++ b/extensions/codex/src/app-server/vercel-provider.ts
@@ -0,0 +1,176 @@
+import { createHash } from "node:crypto";
+import { readFileSync, statSync } from "node:fs";
+import path from "node:path";
+import type { CodexConfigReadClient } from "./config-layer-policy.js";
+import { readCodexEffectiveConfig } from "./config-layer-policy.js";
+import { readRecord } from "./config-utils.js";
+
+export const CODEX_VERCEL_API_KEY_ENV = "AI_GATEWAY_API_KEY";
+const VERCEL_CODEX_BASE_URL = "https://ai-gateway.vercel.sh/codex/v1";
+const VERCEL_PROVIDER_FIELDS = new Set([
+  "name",
+  "base_url",
+  "env_key",
+  "env_key_instructions",
+  "wire_api",
+  "requires_openai_auth",
+  "supports_websockets",
+  "supports_standalone_web_search",
+  "request_max_retries",
+  "stream_max_retries",
+  "stream_idle_timeout_ms",
+  "websocket_connect_timeout_ms",
+]);
+
+/** One explicit native transport contract, shared by credential and reviewer admission. */
+export function isTrustedCodexVercelConfig(config: Record<string, unknown>): boolean {
+  const provider = readRecord(readRecord(config.model_providers)?.vercel);
+  return (
+    config.model_provider === "vercel" &&
+    provider !== undefined &&
+    (provider.base_url === VERCEL_CODEX_BASE_URL ||
+      provider.base_url === `${VERCEL_CODEX_BASE_URL}/`) &&
+    provider.env_key === CODEX_VERCEL_API_KEY_ENV &&
+    provider.wire_api === "responses" &&
+    ["requires_openai_auth", "supports_websockets", "supports_standalone_web_search"].every(
+      (key) => provider[key] == null || provider[key] === false,
+    ) &&
+    Object.entries(provider).every(
+      ([key, value]) => value == null || VERCEL_PROVIDER_FIELDS.has(key),
+    ) &&
+    config.openai_base_url == null &&
+    // Native config/read materializes this default even for custom providers.
+    (config.chatgpt_base_url == null ||
+      config.chatgpt_base_url === "https://chatgpt.com/backend-api/")
+  );
+}
+
+export function codexVercelEnvironmentIsDirect(env: NodeJS.ProcessEnv): boolean {
+  const overrides = new Set([
+    "HTTP_PROXY",
+    "HTTPS_PROXY",
+    "ALL_PROXY",
+    "OPENAI_BASE_URL",
+    "OPENAI_API_BASE",
+  ]);
+  return !Object.entries(env).some(
+    ([key, value]) => overrides.has(key.toUpperCase()) && value?.trim(),
+  );
+}
+
+export type CodexVercelCatalog = {
+  path: string;
+  sha256: string;
+  models: Map<string, string | undefined>;
+};
+
+export function readCodexVercelCatalog(config: Record<string, unknown>): CodexVercelCatalog {
+  const catalogPath = config.model_catalog_json;
+  if (typeof catalogPath !== "string" || !path.isAbsolute(catalogPath)) {
+    throw new Error("Vercel Codex requires an explicit native model catalog.");
+  }
+  const stat = statSync(catalogPath);
+  if (!stat.isFile() || stat.size > 32 * 1024 * 1024) {
+    throw new Error("Vercel Codex model catalog is not a bounded regular file.");
+  }
+  const bytes = readFileSync(catalogPath);
+  const entries: unknown = JSON.parse(bytes.toString("utf8")).models;
+  if (!Array.isArray(entries) || !entries.length) {
+    throw new Error("Vercel Codex model catalog is empty or invalid.");
+  }
+  const models = new Map<string, string | undefined>();
+  for (const entry of entries) {
+    const model = readRecord(entry);
+    const slug = model?.slug;
+    const reviewer = model?.auto_review_model_override;
+    if (
+      typeof slug !== "string" ||
+      !slug ||
+      models.has(slug) ||
+      (reviewer != null && (typeof reviewer !== "string" || !reviewer))
+    ) {
+      throw new Error("Vercel Codex model catalog contains invalid model or reviewer metadata.");
+    }
+    models.set(slug, typeof reviewer === "string" ? reviewer : undefined);
+  }
+  return { path: catalogPath, sha256: createHash("sha256").update(bytes).digest("hex"), models };
+}
+
+export function codexVercelCatalogIncludesModel(
+  catalog: CodexVercelCatalog,
+  model: unknown,
+): boolean {
+  if (typeof model !== "string" || !catalog.models.has(model)) {
+    return false;
+  }
+  const reviewer = catalog.models.get(model);
+  return reviewer === undefined || catalog.models.has(reviewer);
+}
+
+/** Every native config reload is admitted against the process's original catalog. */
+export async function assertCodexVercelRequest(params: {
+  client: CodexConfigReadClient & {
+    request(method: string, params: unknown, options?: { signal?: AbortSignal }): Promise<unknown>;
+  };
+  catalog: CodexVercelCatalog;
+  method: string;
+  requestParams: unknown;
+  defaultCwd: string;
+  signal?: AbortSignal;
+}): Promise<void> {
+  const request = readRecord(params.requestParams);
+  if (!request || (request.modelProvider != null && request.modelProvider !== "vercel")) {
+    throw new Error("Vercel Codex request cannot change native providers.");
+  }
+  const overrides = readRecord(request.config);
+  if (
+    overrides &&
+    Object.keys(overrides).some((key) =>
+      /^(?:model|model_provider|model_providers|model_catalog_json|openai_base_url|chatgpt_base_url)(?:\.|$)/u.test(
+        key,
+      ),
+    )
+  ) {
+    throw new Error("Vercel Codex request cannot override its prepared provider or catalog.");
+  }
+  let cwd = typeof request.cwd === "string" ? request.cwd : undefined;
+  if (!cwd && typeof request.threadId === "string") {
+    const response = readRecord(
+      await params.client.request(
+        "thread/read",
+        { threadId: request.threadId, includeTurns: false },
+        { signal: params.signal },
+      ),
+    );
+    const thread = readRecord(response?.thread);
+    if (typeof thread?.cwd !== "string") {
+      throw new Error("Vercel Codex cannot verify the native thread workspace.");
+    }
+    cwd = thread.cwd;
+  }
+  const effective = await readCodexEffectiveConfig(
+    params.client,
+    cwd ?? params.defaultCwd,
+    params.signal,
+  );
+  if (!isTrustedCodexVercelConfig(effective.config)) {
+    throw new Error("Vercel Codex request requires the trusted Vercel provider.");
+  }
+  const catalog = readCodexVercelCatalog(effective.config);
+  if (catalog.path !== params.catalog.path || catalog.sha256 !== params.catalog.sha256) {
+    throw new Error("Vercel Codex native catalog changed; start a new prepared process.");
+  }
+  const collaboration = readRecord(readRecord(request.collaborationMode)?.settings);
+  const model =
+    collaboration?.model ??
+    request.model ??
+    (params.method === "thread/start" ? effective.config.model : undefined);
+  if (model === undefined && params.method === "turn/start") {
+    return;
+  }
+  if (!codexVercelCatalogIncludesModel(catalog, model)) {
+    throw new Error(
+      "Vercel Codex requires a catalog-listed model and reviewer before native execution.",
+    );
+  }
+}
