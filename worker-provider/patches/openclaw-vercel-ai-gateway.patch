+import type {
+  ProviderModelRouteResolution,
+  ProviderResolveModelRoutesContext,
+} from "openclaw/plugin-sdk/provider-model-types";
+
+const CODEX_BASE_URL = "https://ai-gateway.vercel.sh/codex/v1";
+
+export function resolveModelRoutes(
+  context: ProviderResolveModelRoutesContext,
+): ProviderModelRouteResolution | null {
+  if (context.provider.trim().toLowerCase() !== "vercel-ai-gateway") {
+    return null;
+  }
+  const api = context.configuredModel?.api ?? context.configuredProvider?.api;
+  const baseUrl = context.configuredModel?.baseUrl ?? context.configuredProvider?.baseUrl;
+  // Native transport is an explicit opt-in; the existing Messages route stays unchanged.
+  if (api !== "openai-responses" || typeof baseUrl !== "string") {
+    return null;
+  }
+  if (baseUrl.trim().replace(/\/$/, "") !== CODEX_BASE_URL) {
+    return null;
+  }
+  const requestTransportOverrides = context.requestTransportOverrides ?? "none";
+  return {
+    kind: "routes",
+    routes: [
+      {
+        api,
+        baseUrl: CODEX_BASE_URL,
+        authRequirement: "api-key",
+        requestTransportOverrides,
+        runtimePolicy: {
+          compatibleIds:
+            requestTransportOverrides === "none" ? ["openclaw", "codex"] : ["openclaw"],
+        },
+      },
+    ],
+    defaultRuntimeId: "openclaw",
+  };
+}
